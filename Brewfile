# macOS requirements for building and running Hype. Install with: brew bundle
brew "qt"                 # Qt 6.9 or newer
brew "source-highlight"   # code highlighting, bundled into HypeX.app
brew "ffmpeg"             # first frames of videos, used from Homebrew at runtime
brew "webp"               # animated WebP
brew "dylibbundler"       # copies source-highlight's libraries into HypeX.app
cask "font-jetbrains-mono"             # Hype's default font
cask "font-jetbrains-mono-nerd-font"   # Omarchy's system font

#!/bin/sh
# Build HypeX.app, copy it to /Applications and put the hype command on PATH.
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
"$ROOT/bin/build-macos"
ditto "$ROOT/build-macos/HypeX.app" /Applications/HypeX.app
# A wrapper, not a symlink: Qt finds the bundle's plugins only from the real path.
printf '#!/bin/sh\nexec /Applications/HypeX.app/Contents/MacOS/HypeX "$@"\n' >"$(brew --prefix)/bin/hype"
chmod +x "$(brew --prefix)/bin/hype"
echo "Installed /Applications/HypeX.app and $(brew --prefix)/bin/hype"

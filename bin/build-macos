#!/bin/sh
# Build a self-contained build-macos/HypeX.app: Qt, source-highlight and the stock
# Omarchy themes inside, ad-hoc signed. ffmpeg comes from Homebrew at runtime.
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
if ! brew bundle check --file="$ROOT/Brewfile" >/dev/null; then
    echo "Missing requirements. Install them with: brew bundle --file=\"$ROOT/Brewfile\"" >&2
    brew bundle check --file="$ROOT/Brewfile" --verbose >&2 || true
    exit 1
fi
BREW="$(brew --prefix)"
BUILD="$ROOT/build-macos"
APP="$BUILD/HypeX.app"
mkdir -p "$BUILD"
cd "$BUILD"
qmake "$ROOT/hype.pro"
make -j"$(sysctl -n hw.ncpu)"
# Qt frameworks and QML modules.
# Homebrew splits Qt into kegs (qtbase, qtsvg, ...); name every one so @rpaths resolve.
LIBPATHS=""
for keg in "$BREW"/opt/qt*/lib; do LIBPATHS="$LIBPATHS -libpath=$keg"; done
# It reports unresolvable rpaths for QML plugins Hype never loads; the checks below
# are what matter.
# shellcheck disable=SC2086
macdeployqt "$APP" -qmldir="$ROOT/src" -always-overwrite $LIBPATHS 2>&1 | grep ERROR >&2 || true
# Qt needs the md4c ABI it was built against, or _underline_ is lost (see macos/build-md4c).
cp -f "$("$ROOT/macos/build-md4c")" "$APP/Contents/Frameworks/libmd4c.0.dylib"
# Commands and exports run offscreen; macdeployqt only ships the cocoa platform.
cp -f "$BREW/opt/qtbase/share/qt/plugins/platforms/libqoffscreen.dylib" "$APP/Contents/PlugIns/platforms/"
# source-highlight with its libraries and language definitions.
cp -f "$BREW/bin/source-highlight" "$APP/Contents/MacOS/source-highlight"
dylibbundler -of -b -cd -x "$APP/Contents/MacOS/source-highlight" \
    -d "$APP/Contents/Frameworks" -p @executable_path/../Frameworks/ >/dev/null
mkdir -p "$APP/Contents/Resources/source-highlight"
cp -RLf "$BREW/share/source-highlight/." "$APP/Contents/Resources/source-highlight/"
codesign --force --deep --sign - "$APP"
# Self-contained: nothing the app loads may point into Homebrew (a library's own
# install name, the first line otool prints for it, doesn't count)...
linked="$(find "$APP/Contents" -type f \( -name '*.dylib' -o -path '*/MacOS/*' -o -path '*.framework/Versions/A/*' \) |
    while read -r binary; do
        id="$(otool -D "$binary" | sed -n 2p)"
        otool -L "$binary" | tail -n +2 | awk '{print $1}' | grep -vxF "${id:-none}" |
            grep '^/opt/homebrew/' | sed "s|^|${binary#"$APP/"} -> |" || true
    done)"
if [ -n "$linked" ]; then
    echo "HypeX.app still loads Homebrew libraries:" >&2
    echo "$linked" >&2
    exit 1
fi
# ...and it must work from a bare environment, as when Finder opens it.
env -i HOME="$HOME" PATH=/usr/bin:/bin "$APP/Contents/MacOS/HypeX" check "$ROOT/examples/welcome.md" >/dev/null
echo "Built $APP"
